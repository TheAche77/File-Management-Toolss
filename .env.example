# Root workspace example environment
# Copy values into your local shell or your own .env files as needed.

# -------------------------------------------------------------------
# API server
# -------------------------------------------------------------------
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scopri_italia
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
LOG_LEVEL=info
SLG_USER_AGENT=StreetLevelDiscovery/1.0 (https://github.com/TheAche77/File-Management-Toolss)

# Optional: connector placeholder, currently not fully implemented
GOOGLE_MAPS_API_KEY=

# Optional legal/free enrichment connectors
# Wikidata is enabled by default. Set to false to disable all Wikidata calls.
ENABLE_WIKIDATA_ENRICHMENT=true

# OpenCorporates requires an approved API account/token and is not enabled by default.
OPENCORPORATES_API_TOKEN=

# Protects admin routes, review flows, outreach editing, dashboard, and pipeline.
# Required for API startup.

# -------------------------------------------------------------------
# Frontend (run in a separate shell)
# -------------------------------------------------------------------
# For the Vite frontend, override PORT and BASE_PATH in the shell where
# you launch `@workspace/gallery-map`.
#
# Example:
# PORT=19001
BASE_PATH=/
VITE_API_PROXY_TARGET=http://localhost:8080
