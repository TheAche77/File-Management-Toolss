# Root workspace example environment
# Copy values into your local shell or your own .env files as needed.
#
# On Replit: DATABASE_URL is injected automatically by the postgresql-16 module.
# ADMIN_API_TOKEN must be set as a Replit Secret (not a plain env var).
# See the "Running on Replit" section in README.md for the full setup guide.

# -------------------------------------------------------------------
# API server (required)
# -------------------------------------------------------------------
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scopri_italia

# Required for API startup — the server fails fast if this is missing.
# On Replit: set this as a Replit Secret, NOT as a plain env var.
# Locally: use a long random string, e.g. openssl rand -hex 32
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

LOG_LEVEL=info

# Optional: Google Places connector (currently a stub, not fully implemented)
GOOGLE_MAPS_API_KEY=

# -------------------------------------------------------------------
# Frontend (run in a separate shell or process)
# -------------------------------------------------------------------
PORT=19001
BASE_PATH=/
VITE_API_PROXY_TARGET=http://localhost:8080
